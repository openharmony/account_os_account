import("../authorization_stub_shared.gni")

ohos_fuzztest("ReleaseAuthorizationStubFuzzTest") {
  module_out_path = fuzz_output_path
  fuzz_config_file = "."
  version_script = "${services_path}/accountmgr/libaccountmgr.map"
  configs = [
    "${os_account_path}/test/fuzztest/authorization_stub:authorization_stub_fuzztest_config",
    "${os_account_path}/test/fuzztest/authorization_stub:authorization_stub_config",
  ]
  sources = authorization_stub_common_sources
  sources +=
      [ "releaseauthorizationstub_fuzzer.cpp" ]
  deps = authorization_stub_deps
  external_deps = authorization_stub_ext_deps
}
