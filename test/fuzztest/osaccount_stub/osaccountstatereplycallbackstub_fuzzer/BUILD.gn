import("../osaccount_stub_shared.gni")

ohos_fuzztest("OsAccountStateReplyCallbackStubFuzzTest") {
  module_out_path = fuzz_output_path
  fuzz_config_file = "."
  configs = [
    "${os_account_path}/test/fuzztest/osaccount_stub:osaccount_stub_common_config",
  ]
  include_dirs = [
    "${os_account_innerkits_native_path}/include",
    "${os_account_path}/test/fuzztest/osaccount_stub/common",
  ]
  sources = [
    "osaccountstatereplycallbackstub_fuzzer.cpp",
    "${os_account_path}/services/accountmgr/src/osaccount/os_account_state_reply_callback_service.cpp",
  ]
  deps = [
    "${os_account_path}/frameworks/common:libaccount_common",
    "${os_account_innerkits_native_path}:os_account_innerkits",
    "${os_account_innerkits_native_path}:os_account_state_reply_callback_stub",
    "${os_account_path}/services/accountmgr:accountmgr",
  ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]
}
