@!namespace("@ohos.account.osAccount.authorization", "authorization")
@!sts_inject_into_module("import { BusinessError } from '@ohos.base';")
@!sts_inject_into_module("import Context from 'application.Context';")
@!sts_inject("""
static { loadLibrary("authorization_taihe_native.z") }
""")

enum Privilege: String {
    PRIVILEGE_OPERATE_RAW_NET_PACKETS = "ohos.privilege.operate_raw_net_packets",
}

enum AuthorizationResultCode: i32 {
    AUTHORIZATION_SUCCESS = 0,
    AUTHORIZATION_CANCELED = 12300301,
    AUTHORIZATION_INTERACTION_NOT_ALLOWED = 12300302,
    AUTHORIZATION_DENIED = 12300303,
    AUTHORIZATION_SERVICE_BUSY = 12300304,
    AUTHORIZATION_PRIVILEGE_NOT_SUPPORTED = 12300305,
}

struct AuthorizationResult {
    resultCode: AuthorizationResultCode;
    privilege: Privilege;
}

interface AuthorizationManager {
    @rename("requestAuthorization")
    @promise
    AcquireAuthorizationPromise(privilege: Privilege, context: @sts_type("Context")Opaque): AuthorizationResult;

    @rename("hasAuthorization")
    @promise
    HasAuthorizationPromise(privilege: Privilege): bool;
}

function GetAuthorizationManager(): AuthorizationManager;
