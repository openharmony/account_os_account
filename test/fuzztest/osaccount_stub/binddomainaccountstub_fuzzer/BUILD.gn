import("../osaccount_stub_shared.gni")

ohos_fuzztest("BindDomainAccountStubFuzzTest") {
  module_out_path = fuzz_output_path
  fuzz_config_file = "."
  configs = [ "${os_account_path}/test/fuzztest/osaccount_stub:osaccount_stub_common_config" ]
  sources = [
    "${os_account_path}/services/accountmgr/src/osaccount/os_account_manager_service.cpp",
    "binddomainaccountstub_fuzzer.cpp",
  ]
  deps = osaccount_stub_deps + [
    "${domain_account_framework_path}:domain_account_innerkits",
  ]
  external_deps = osaccount_stub_ext_deps + [
    "access_token:libnativetoken_shared",
    "access_token:libtokensetproc_shared",
  ]
  cflags_cc = []
  if (os_account_support_domain_accounts) {
    cflags_cc += [ "-DSUPPORT_DOMAIN_ACCOUNTS" ]
  }
}
